<div class="page-header">
  <div>
    <h1>Tasks</h1>
    <p>Manage and track project tasks.</p>
  </div>

<% if current_user.admin? || current_user.employee? %>
<%= link_to "New Task",
new_task_path,
class: "button button-primary" %>
<% end %>

</div>

<div class="card">
  <%= form_with url: tasks_path,
                method: :get,
                local: true do |form| %>

<div class="filter-grid">

  <div class="form-group">
    <%= form.label :search, "Search" %>
    <%= form.text_field :search,
                        value: params[:search],
                        placeholder: "Search task..." %>
  </div>

  <div class="form-group">
    <%= form.label :status, "Status" %>

    <%= form.select :status,
                    options_for_select(
                      Task.statuses.keys.map {
                        |status| [status.humanize, status]
                      },
                      params[:status]
                    ),
                    { include_blank: "All Statuses" } %>
  </div>

  <div class="form-group">
    <%= form.label :priority, "Priority" %>

    <%= form.select :priority,
                    options_for_select(
                      Task.priorities.keys.map {
                        |priority| [priority.humanize, priority]
                      },
                      params[:priority]
                    ),
                    { include_blank: "All Priorities" } %>
  </div>

  <div class="filter-button">
    <%= form.submit "Filter",
                    class: "button button-primary" %>

    <%= link_to "Clear",
                tasks_path,
                class: "button button-secondary" %>
  </div>

</div>


<% end %>

</div>

<% if @tasks.any? %>

  <div class="task-grid">

<% @tasks.each do |task| %>

  <div class="task-card">

    <div class="task-card-header">

      <h2>
        <%= link_to task.title,
                    task_path(task) %>
      </h2>

      <span class="status-badge status-<%= task.status %>">
        <%= task.status.humanize %>
      </span>

    </div>

    <p class="task-description">
      <%= truncate(task.description, length: 120) %>
    </p>

    <div class="task-details">

      <div>
        <strong>Project</strong>
        <span>
          <%= task.project.name %>
        </span>
      </div>

      <div>
        <strong>Assignee</strong>
        <span>
          <%= task.assignee.name %>
        </span>
      </div>

      <div>
        <strong>Priority</strong>
        <span class="priority-<%= task.priority %>">
          <%= task.priority.humanize %>
        </span>
      </div>

      <div>
        <strong>Due Date</strong>
        <span>
          <%= task.due_date.strftime("%d %b %Y") %>
        </span>
      </div>

    </div>

    <div class="task-actions">

      <%= link_to "View",
                  task_path(task),
                  class: "button button-secondary" %>

      <% if policy(task).edit? %>
        <%= link_to "Edit",
                    edit_task_path(task),
                    class: "button button-primary" %>
      <% end %>

      <% if policy(task).destroy? %>
        <%= button_to "Delete",
                      task_path(task),
                      method: :delete,
                      data: {
                        turbo_confirm: "Are you sure you want to delete this task?"
                      },
                      class: "button button-danger" %>
      <% end %>

    </div>

  </div>

<% end %>


  </div>

<% else %>

  <div class="card empty-state">
    <h2>No tasks found</h2>
    <p>There are no tasks matching your search or filter.</p>


<% if current_user.admin? || current_user.employee? %>
  <%= link_to "Create First Task",
              new_task_path,
              class: "button button-primary" %>
<% end %>


  </div>

<% end %>
