<div class="page-header">

  <div>
    <h1><%= @task.title %></h1>


<p>
  Project:
  <strong>
    <%= @task.project.name %>
  </strong>
</p>


  </div>

  <div class="actions">


<% if policy(@task).edit? %>
  <%= link_to "Edit",
              edit_task_path(@task),
              class: "button button-primary" %>
<% end %>

<%= link_to "Back",
            tasks_path,
            class: "button button-secondary" %>


  </div>

</div>

<div class="task-show-grid">

  <div class="card">


<h2>Task Details</h2>

<div class="detail-row">
  <strong>Description</strong>
  <p>
    <%= simple_format(@task.description) %>
  </p>
</div>

<div class="detail-row">
  <strong>Status</strong>

  <span class="status-badge status-<%= @task.status %>">
    <%= @task.status.humanize %>
  </span>
</div>

<div class="detail-row">
  <strong>Priority</strong>

  <span class="priority-<%= @task.priority %>">
    <%= @task.priority.humanize %>
  </span>
</div>

<div class="detail-row">
  <strong>Due Date</strong>

  <span>
    <%= @task.due_date.strftime("%d %B %Y") %>
  </span>
</div>


  </div>

  <div class="card">


<h2>Assignment</h2>

<div class="detail-row">
  <strong>Project</strong>

  <%= link_to @task.project.name,
              project_path(@task.project) %>
</div>

<div class="detail-row">
  <strong>Assignee</strong>

  <span>
    <%= @task.assignee.name %>
  </span>
</div>


  </div>

</div>

<div class="card">

  <h2>Attachment</h2>

<% if @task.attachment.attached? %>

<div class="attachment">

  <span>
    <%= @task.attachment.filename %>
  </span>

  <%= link_to "Download",
              rails_blob_path(
                @task.attachment,
                disposition: "attachment"
              ),
              class: "button button-secondary" %>

</div>


<% else %>


<p>No attachment uploaded.</p>


<% end %>

</div>

<% if policy(@task).destroy? %>

  <div class="card danger-zone">

<h2>Danger Zone</h2>

<p>
  Deleting this task cannot be undone.
</p>

<%= button_to "Delete Task",
              task_path(@task),
              method: :delete,
              data: {
                turbo_confirm:
                  "Are you sure you want to delete this task?"
              },
              class: "button button-danger" %>


  </div>

<% end %>
