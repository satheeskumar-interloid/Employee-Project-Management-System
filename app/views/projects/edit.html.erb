% content_for :title, "Edit Project" %>

<div class="page-header">
  <div>
    <h1>Edit Project</h1>
    <p>Update project details and manage project members.</p>
  </div>
  <div class="actions">
    <%= link_to "Back to Projects", projects_path, class: "button button-secondary" %>
    <%= link_to "View Project", project_path(@project), class: "button button-secondary" %>
  </div>
</div>
<div class="card">
  <%= render "form", project: @project %>
</div>