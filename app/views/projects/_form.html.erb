<%= form_with model: project do |form| %>

  <% if project.errors.any? %>
    <div class="flash flash-error">
      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="form-group">
    <%= form.label :status %>
    <%= form.select :status,
                    Project.statuses.keys.map {
                      |status| [status.humanize, status]
                    } %>
  </div>

  <div class="form-group">
    <%= form.label :start_date %>
    <%= form.date_field :start_date %>
  </div>

  <div class="form-group">
    <%= form.label :end_date %>
    <%= form.date_field :end_date %>
  </div>
<div class="form-group">
  <%= form.label :member_ids, "Project Members" %>

  <div class="member-list">

    <% User.employee.each do |employee| %>

      <div class="member-checkbox">
        <%= check_box_tag "project[member_ids][]",
                          employee.id,
                          project.member_ids.include?(employee.id),
                          id: "member_#{employee.id}" %>

        <%= label_tag "member_#{employee.id}" do %>
          <strong><%= employee.name %></strong>
          <span><%= employee.email %></span>
        <% end %>
      </div>

    <% end %>

  </div>
</div>

  <%= form.submit "Save Project",
                  class: "button button-primary" %>

<% end %>